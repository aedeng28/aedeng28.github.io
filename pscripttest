import secrets
import base64

def encrypt_xor(plain_text):
    # Convert input string to raw binary bytes
    ptxt_bytes = plain_text.encode('utf-8')
    
    # Generate a truly random key of matching length
    key_bytes = secrets.token_bytes(len(ptxt_bytes))
    
    # Apply bitwise XOR
    ctxt_bytes = bytes(p ^ k for p, k in zip(ptxt_bytes, key_bytes))
    
    return ctxt_bytes, key_bytes

def decrypt_xor(ctxt_bytes, key_bytes):
    # Apply bitwise XOR again to decrypt
    ptxt_bytes = bytes(c ^ k for c, k in zip(ctxt_bytes, key_bytes))
    return ptxt_bytes.decode('utf-8')

# --- Execution ---
message = input("Enter plain text: ")

# Run Encryption
ciphertext, random_key = encrypt_xor(message)

# Convert raw bytes to standard copy-pasteable Text (Base64)
key_text = base64.b64encode(random_key).decode('utf-8')
ciphertext_text = base64.b64encode(ciphertext).decode('utf-8')

print("\n--- ENCRYPTION OUTPUT ---")
print("🔒 Hexadecimal Strings (For analyzing raw values):")
print(f"   Key (Hex):        {random_key.hex()}")
print(f"   Ciphertext (Hex): {ciphertext.hex()}")
print("\n📋 Text Strings (Safe for copy-pasting into text messages/emails):")
print(f"   Key (Text):       {key_text}")
print(f"   Ciphertext (Text):{ciphertext_text}")


print("\n--- DECRYPTION CHECK ---")
# To decrypt text back, we reverse the Base64 encoding back into raw bytes first
decoded_key_bytes = base64.b64decode(key_text.encode('utf-8'))
decoded_ctxt_bytes = base64.b64decode(ciphertext_text.encode('utf-8'))

# Run Decryption
decrypted_message = decrypt_xor(decoded_ctxt_bytes, decoded_key_bytes)
print(f"🔓 Decrypted Output: {decrypted_message}")
