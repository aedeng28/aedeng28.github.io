import itertools
import heapq

# English letter frequency scoring map (higher = more common in English)
ENGLISH_FREQS = {
    'a': 8.17, 'b': 1.49, 'c': 2.78, 'd': 4.25, 'e': 12.70, 'f': 2.23, 'g': 2.02,
    'h': 6.09, 'i': 6.97, 'j': 0.15, 'k': 0.77, 'l': 4.03, 'm': 2.41, 'n': 6.75,
    'o': 7.51, 'p': 1.93, 'q': 0.09, 'r': 5.99, 's': 6.33, 't': 9.06, 'u': 2.76,
    'v': 0.98, 'w': 2.36, 'x': 0.15, 'y': 1.97, 'z': 0.07
}

def ln(L):
    return 0 if L == "" else ord(L.lower()) - ord('a') + 1

def nl(L):
    return chr((L - 1) % 26 + ord('a'))

def iter(a, b):
    return (a - b) % 26

def get_english_score(text):
    """Calculates a total score based on English letter frequencies, ignoring spaces."""
    return sum(ENGLISH_FREQS.get(char, 0) for char in text if char != ' ')

ptxt = input("plain text: ")
key = input("key (no spaces): ")
ptxt = ptxt.lower()
key = key.lower()

# Encryption process (ignoring spaces for key stepping)
ctxt_list = []
key_idx = 0
for char in ptxt:
    if char == ' ':
        ctxt_list.append(' ')
    else:
        # Step the key only when encrypting actual letters
        ctxt_list.append(nl(ln(char) * ln(key[key_idx % len(key)]) % 26))
        key_idx += 1

ctxt = "".join(ctxt_list)
print(f"\nEncrypted Ciphertext: {ctxt}\n")

# Finding possibilities per character index
fpos = []
key_idx = 0
for i, char in enumerate(ctxt):
    if char == ' ':
        fpos.append([' '])
    else:
        pos = []
        p = ln(char)
        for j in range(26):
            p = iter(p, ln(key[key_idx % len(key)]))
            if p == 0:
                pos.append(nl(j + 1))
        fpos.append(pos)
        key_idx += 1

print("--- Decoding Complete (Evaluating Top Combinations) ---")

# Memory-safe collection using heapq to get the top 5 combinations
# We generate all combinations using itertools.product but store only the top 5 highest scores
top_n = heapq.nlargest(
    5, 
    ("".join(combo) for combo in itertools.product(*fpos)), 
    key=get_english_score
)

# Display results
for rank, text in enumerate(top_n, 1):
    score = get_english_score(text)
    print(f"Rank {rank} (Score: {score:.2f}): {text}")
